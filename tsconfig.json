{
	"include": ["src/**/*"],
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"allowJs": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./lib",
		"rootDir": "./src",
		"strict": false,
		"noImplicitAny": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	}
}
